# Database Configuration
DB_ROOT_PASSWORD=root123
DB_NAME=springapp
DB_USER=neo
DB_PASSWORD=neo123
DB_PORT=3306

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
REDIS_PORT=6379

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=production
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Security (change these in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Spring Boot SMTP (local development or Render backend)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-google-app-password

# Notification Email Settings for Vercel serverless function
# Set these in your real environment (Vercel dashboard or .env), not in production code.
MAIL_SERVICE=gmail
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="NeoBank" <your-email@gmail.com>

