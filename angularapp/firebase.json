{
  "hosting": {
    "predeploy": [
      "./firebase-predeploy.cmd"
    ],
    "public": "dist/angularapp/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}